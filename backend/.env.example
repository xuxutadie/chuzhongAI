# 复制为 .env 后填写真实部署参数；此示例不包含任何真实密钥。
# 重要：development 仅供本机 127.0.0.1 使用。部署到局域网、服务器、Docker 或公网前，
# 必须改为 APP_ENV=production，并设置高强度 BOOTSTRAP_SETUP_CODE；否则不要暴露后端端口。
APP_ENV=development

# 学生账户、会话与学习工作台（默认使用 backend/data/ai_coach.db）
STUDENT_WORKSPACE_DATABASE_PATH=./data/ai_coach.db
SESSION_TTL_HOURS=12
# 预留字段，当前会话使用随机令牌与服务端哈希校验，此字段未参与签名，无需填写。
APP_SESSION_SECRET=
# 公开部署时请设置高强度的一次性首次教师初始化码；本机 development 可留空。
BOOTSTRAP_SETUP_CODE=

# 旧版 PostgreSQL 学习记录接口；未使用时可保持默认值。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_middle_school_coach

# 明天填写大模型配置。不要使用 NEXT_PUBLIC 前缀，也不要把密钥填进前端页面。
# PROVIDER 可填服务名或 openai_compatible；BASE_URL 填 HTTPS 基础地址，
# 系统自动追加 /chat/completions，不要重复填写该后缀；MODEL 填实际开通的模型标识。
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OCR 服务配置。当前正式实现支持 OpenAI 兼容视觉接口：
# OCR_PROVIDER=openai_compatible_vision，并填写 HTTPS 接口地址、Key 与视觉模型名。
# OCR_API_BASE_URL 同样是基础地址，不包含 /chat/completions 后缀。
# 未填写时，系统会保留手动录入和确认流程，不会伪造识别结果。
OCR_ENABLED=false
OCR_PROVIDER=
OCR_API_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
# 以下仅标记未来其他厂商可能需要的字段，当前实现不支持，请保持注释。
# OCR_SECRET_ID=
# OCR_SECRET_KEY=
# OCR_REGION=
