  "packages": [
    {
      "id":"g7u-c5-concepts", "subject":"数学", "grade":7, "semester":"上册", "textbookVersion":"北师大版", "chapterId":"g7u-chapter-5", "title":"方程与一元一次方程的认识", "lessonId":"g7-upper-equations", "learningMode":"explanation",
      "capabilityTags":["方程辨认", "一次方程辨认", "方程的解", "含参条件"],
      "learningGuide":{
        "steps":["方程是含有未知数的等式：既要有等号，又要有未知数。仅有代数式或仅有数字等式，都不符合方程定义。", "辨认一元一次方程时，检查只含一个未知数、未知数项的次数是 1，且未知数不能在分母中；化简后可写成 ax＋b＝0，其中 a 不为 0。", "检验某个数是不是方程的解，要把它代入原方程，分别算出左、右两边的值。只有两边相等，才是方程的解。", "遇到含参数的题，先分清未知数和参数。已知解时可代入求参数；要求是一元一次方程时，化简后未知数的系数不能为 0。"],
        "pitfalls":["含有字母但没有等号的是代数式，不要把表达式误认成方程。", "检验解要代入原方程，不能因为答案看起来简单就跳过两边比较；参数让一次项系数变成 0 时，要单独判断。"]
      },
      "questions":[
        {"id":"g7u-c5-concepts-d01","knowledgePointId":"g7u-c5-concepts","capabilityTag":"方程辨认","difficulty":"basic","responseType":"single-choice","prompt":"下列式子中，哪一个是方程？","options":[{"id":"a","text":"2x＋3"},{"id":"b","text":"2x＋3＝7"},{"id":"c","text":"2＋3＝5"},{"id":"d","text":"x＞3"}],"correctAnswer":"b","explanation":"方程必须是含未知数的等式。2x＋3＝7 同时有未知数 x 和等号。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d02","knowledgePointId":"g7u-c5-concepts","capabilityTag":"一次方程辨认","difficulty":"basic","responseType":"single-choice","prompt":"下列关于 x 的式子中，哪一个是一元一次方程？","options":[{"id":"a","text":"x²＝4"},{"id":"b","text":"x＋y＝6"},{"id":"c","text":"2x＋1＝5"},{"id":"d","text":"1/x＝2"}],"correctAnswer":"c","explanation":"2x＋1＝5 只有一个未知数 x，未知数的次数为 1，且分母中不含未知数。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d03","knowledgePointId":"g7u-c5-concepts","capabilityTag":"方程的解","difficulty":"basic","responseType":"true-false","prompt":"x＝3 是方程 2x＋1＝7 的解。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"把 x＝3 代入，左边为 2×3＋1＝7，与右边相等，所以它是方程的解。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d04","knowledgePointId":"g7u-c5-concepts","capabilityTag":"方程辨认","difficulty":"advanced","responseType":"multi-choice","prompt":"下列式子中，哪些是方程？（多选）","options":[{"id":"a","text":"x－2＝4"},{"id":"b","text":"3a＝9"},{"id":"c","text":"2＋3＝5"},{"id":"d","text":"2x＋1"}],"correctAnswer":["a","b"],"explanation":"x－2＝4 和 3a＝9 都是含未知数的等式；数字等式没有未知数，代数式没有等号。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d05","knowledgePointId":"g7u-c5-concepts","capabilityTag":"方程的解","difficulty":"advanced","responseType":"single-choice","prompt":"把 x＝－2 代入 3x＋4，所得的值是多少？","options":[{"id":"a","text":"－10"},{"id":"b","text":"－2"},{"id":"c","text":"2"},{"id":"d","text":"10"}],"correctAnswer":"b","explanation":"先乘后加，3×（－2）＋4＝－6＋4＝－2，可用此值检验方程左边。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d06","knowledgePointId":"g7u-c5-concepts","capabilityTag":"一次方程辨认","difficulty":"advanced","responseType":"true-false","prompt":"0x＝5 是一元一次方程。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"化简后为 0＝5，未知数的一次项系数为 0，不符合一元一次方程的条件。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d07","knowledgePointId":"g7u-c5-concepts","capabilityTag":"方程的解","difficulty":"advanced","responseType":"single-choice","prompt":"下列哪个数是方程 2x＋5＝3 的解？","options":[{"id":"a","text":"－1"},{"id":"b","text":"1"},{"id":"c","text":"3"},{"id":"d","text":"4"}],"correctAnswer":"a","explanation":"代入 x＝－1，2×（－1）＋5＝3；其他三个数代入后左边都不等于 3。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d08","knowledgePointId":"g7u-c5-concepts","capabilityTag":"方程的解","difficulty":"challenge","responseType":"multi-choice","prompt":"下列哪些方程的解是 x＝3？（多选）","options":[{"id":"a","text":"2x＋4＝10"},{"id":"b","text":"5x－4＝11"},{"id":"c","text":"x＋3＝9"},{"id":"d","text":"4x＝8"}],"correctAnswer":["a","b"],"explanation":"代入 x＝3，前两式左边分别是 10 和 11，与右边相等；后两式左边为 6 和 12，与右边不等。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d09","knowledgePointId":"g7u-c5-concepts","capabilityTag":"含参条件","difficulty":"challenge","responseType":"single-choice","prompt":"关于 x 的方程（a－2）x＝8 要是一元一次方程，参数 a 应满足什么条件？","options":[{"id":"a","text":"a＝2"},{"id":"b","text":"a≠2"},{"id":"c","text":"a＝0 才可以"},{"id":"d","text":"a 可以是任何数"}],"correctAnswer":"b","explanation":"未知数 x 的系数 a－2 不能为 0，因此 a－2≠0，即 a≠2。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-d10","knowledgePointId":"g7u-c5-concepts","capabilityTag":"含参条件","difficulty":"challenge","responseType":"single-choice","prompt":"已知 x＝2 是方程 4x＋k＝15 的解，则 k 等于多少？","options":[{"id":"a","text":"3"},{"id":"b","text":"7"},{"id":"c","text":"8"},{"id":"d","text":"23"}],"correctAnswer":"b","explanation":"把 x＝2 代入得到 8＋k＝15，所以 k＝15－8＝7。","source":"local-reviewed"}
      ],
      "retestQuestions":[
        {"id":"g7u-c5-concepts-r01","knowledgePointId":"g7u-c5-concepts","capabilityTag":"方程辨认","difficulty":"basic","responseType":"single-choice","prompt":"以下哪一个式子同时满足“含未知数”和“是等式”？","options":[{"id":"a","text":"5y－2＝13"},{"id":"b","text":"5y－2"},{"id":"c","text":"5－2＝3"},{"id":"d","text":"y＜13"}],"correctAnswer":"a","explanation":"5y－2＝13 含未知数 y 并且使用等号，因此符合方程的定义。","source":"local-reviewed"},
        {"id":"g7u-c5-concepts-r02","knowledgePointId":"g7u-c5-concepts","capabilityTag":"一次方程辨认","difficulty":"basic","responseType":"single-choice","prompt":"下列哪个是一元一次方程？","options":[{"id":"a","text":"y²－1＝0"},{"id":"b","text":"3y－2＝10"},{"id":"c","text":"x＋y＝10"},{"id":"d","text":"2/y＝1"}],"correctAnswer":"b","explanation":"3y－2＝10 只含未知数 y，且 y 的次数为 1；其余分别是二次、二元或分母含未知数。","source":"local-reviewed"},
