    {
      "id":"g7u-c5-basic", "subject":"数学", "grade":7, "semester":"上册", "textbookVersion":"北师大版", "chapterId":"g7u-chapter-5", "title":"等式性质与基础解方程", "lessonId":"g7-upper-equations", "learningMode":"explanation",
      "capabilityTags":["等式性质", "移项求解", "系数化一", "综合求解"],
      "learningGuide":{
        "steps":["等式两边同时加上或减去同一个数（或整式），等式仍成立；同时乘以同一个数也成立，同时除以同一个非零数也成立。", "移项就是在两边做相同的加减操作。例如 3x＋2＝11 两边减 2，得到 3x＝9。移项越过等号时要改变符号。", "把含未知数的项放到一边，常数项放到另一边，再合并同类项，整理成 ax＝b。", "最后两边同时除以非零系数 a，得到 x＝b/a。遇到负系数或分数系数，要注意符号；把结果代回原式检验。"],
        "pitfalls":["不能只对等式的一边运算，也不能把等式两边同时除以 0。", "移项变号与在同一边交换加法项的位置不同；负号和未知数的系数要一起处理。"]
      },
      "questions":[
        {"id":"g7u-c5-basic-d01","knowledgePointId":"g7u-c5-basic","capabilityTag":"移项求解","difficulty":"basic","responseType":"single-choice","prompt":"方程 x＋7＝12 的解是多少？","options":[{"id":"a","text":"x＝5"},{"id":"b","text":"x＝7"},{"id":"c","text":"x＝12"},{"id":"d","text":"x＝19"}],"correctAnswer":"a","explanation":"等式两边同时减去 7，得到 x＝12－7＝5。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d02","knowledgePointId":"g7u-c5-basic","capabilityTag":"系数化一","difficulty":"basic","responseType":"single-choice","prompt":"方程－3x＝18 的解是多少？","options":[{"id":"a","text":"x＝－6"},{"id":"b","text":"x＝6"},{"id":"c","text":"x＝－15"},{"id":"d","text":"x＝15"}],"correctAnswer":"a","explanation":"两边同时除以－3，得到 x＝18÷（－3）＝－6。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d03","knowledgePointId":"g7u-c5-basic","capabilityTag":"移项求解","difficulty":"basic","responseType":"true-false","prompt":"解方程 x－4＝9，可得 x＝5。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"两边应该同时加 4，得到 x＝9＋4＝13，而不是 9－4。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d04","knowledgePointId":"g7u-c5-basic","capabilityTag":"等式性质","difficulty":"advanced","responseType":"multi-choice","prompt":"方程 2x＋3＝11 经过正确变形，能得到哪些式子？（多选）","options":[{"id":"a","text":"2x＝8"},{"id":"b","text":"x＝4"},{"id":"c","text":"2x＝14"},{"id":"d","text":"x＝8"}],"correctAnswer":["a","b"],"explanation":"先两边减 3 得 2x＝8，再两边除以 2 得 x＝4，另外两项没有保持等式关系。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d05","knowledgePointId":"g7u-c5-basic","capabilityTag":"综合求解","difficulty":"advanced","responseType":"single-choice","prompt":"方程 5x－7＝3x＋9 的解是多少？","options":[{"id":"a","text":"x＝1"},{"id":"b","text":"x＝2"},{"id":"c","text":"x＝8"},{"id":"d","text":"x＝16"}],"correctAnswer":"c","explanation":"移项得 5x－3x＝9＋7，合并得 2x＝16，所以 x＝8。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d06","knowledgePointId":"g7u-c5-basic","capabilityTag":"等式性质","difficulty":"advanced","responseType":"true-false","prompt":"等式两边同时除以同一个非零数，所得等式仍然成立。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"这是等式的基本性质，但除数必须非零，因为除以 0 没有意义。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d07","knowledgePointId":"g7u-c5-basic","capabilityTag":"移项求解","difficulty":"advanced","responseType":"single-choice","prompt":"解方程 7－2x＝15，得到什么？","options":[{"id":"a","text":"x＝－11"},{"id":"b","text":"x＝－4"},{"id":"c","text":"x＝4"},{"id":"d","text":"x＝11"}],"correctAnswer":"b","explanation":"两边减 7 得－2x＝8，再除以－2，得到 x＝－4。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d08","knowledgePointId":"g7u-c5-basic","capabilityTag":"综合求解","difficulty":"challenge","responseType":"multi-choice","prompt":"下面哪些方程的解相同且都为 x＝2？（多选）","options":[{"id":"a","text":"4x－3＝5"},{"id":"b","text":"7－x＝5"},{"id":"c","text":"3x＋1＝10"},{"id":"d","text":"2x＝－4"}],"correctAnswer":["a","b"],"explanation":"前两式分别得到 4x＝8、－x＝－2，解都为 2；后两式的解分别是 3、－2。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d09","knowledgePointId":"g7u-c5-basic","capabilityTag":"综合求解","difficulty":"challenge","responseType":"single-choice","prompt":"方程 0.4x＋1.2＝3.6 的解是多少？","options":[{"id":"a","text":"x＝3"},{"id":"b","text":"x＝6"},{"id":"c","text":"x＝9"},{"id":"d","text":"x＝12"}],"correctAnswer":"b","explanation":"先减 1.2 得 0.4x＝2.4，再除以 0.4，得到 x＝6。","source":"local-reviewed"},
        {"id":"g7u-c5-basic-d10","knowledgePointId":"g7u-c5-basic","capabilityTag":"系数化一","difficulty":"challenge","responseType":"single-choice","prompt":"方程（2/3）x－1＝5 的解是多少？","options":[{"id":"a","text":"x＝4"},{"id":"b","text":"x＝6"},{"id":"c","text":"x＝9"},{"id":"d","text":"x＝12"}],"correctAnswer":"c","explanation":"两边加 1 得（2/3）x＝6，再除以 2/3，即乘 3/2，得到 x＝9。","source":"local-reviewed"}
      ],
