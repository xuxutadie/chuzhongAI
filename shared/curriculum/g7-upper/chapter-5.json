      "retestQuestions":[
        {"id":"g7u-c5-applications-r01","knowledgePointId":"g7u-c5-applications","capabilityTag":"数量关系","difficulty":"basic","responseType":"single-choice","prompt":"4 本价格相同的笔记本共花 36 元，每本的价格是多少？","options":[{"id":"a","text":"4 元"},{"id":"b","text":"8 元"},{"id":"c","text":"9 元"},{"id":"d","text":"32 元"}],"correctAnswer":"c","explanation":"设每本 x 元，4x＝36，两边除以 4 得 x＝9。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r02","knowledgePointId":"g7u-c5-applications","capabilityTag":"数量关系","difficulty":"basic","responseType":"single-choice","prompt":"一个长方形的长比宽多 5 cm，周长为 34 cm，宽为多少？","options":[{"id":"a","text":"6 cm"},{"id":"b","text":"9 cm"},{"id":"c","text":"11 cm"},{"id":"d","text":"17 cm"}],"correctAnswer":"a","explanation":"设宽 x cm，则 2(x＋x＋5)＝34，整理为 4x＝24，解得 x＝6。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r03","knowledgePointId":"g7u-c5-applications","capabilityTag":"列式建模","difficulty":"basic","responseType":"true-false","prompt":"每件商品 6 元，买 x 件的总价可表示为 6＋x 元。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"总价等于单价乘数量，应表示为 6x 元，而不是单价加数量。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r04","knowledgePointId":"g7u-c5-applications","capabilityTag":"列式建模","difficulty":"advanced","responseType":"multi-choice","prompt":"母亲现在 36 岁，女儿现在 12 岁。设 x 年后母亲年龄是女儿的 2 倍，可列哪些正确方程？（多选）","options":[{"id":"a","text":"36＋x＝2(12＋x)"},{"id":"b","text":"36＋x＝24＋2x"},{"id":"c","text":"36＝2(12＋x)"},{"id":"d","text":"36＋x＝24＋x"}],"correctAnswer":["a","b"],"explanation":"x 年后母亲、女儿分别是 36＋x、12＋x 岁，前者为后者两倍；括号展开后即第二个方程。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r05","knowledgePointId":"g7u-c5-applications","capabilityTag":"数量关系","difficulty":"advanced","responseType":"single-choice","prompt":"一件商品打九折后售价为 108 元，原价是多少？","options":[{"id":"a","text":"97.2 元"},{"id":"b","text":"117 元"},{"id":"c","text":"120 元"},{"id":"d","text":"180 元"}],"correctAnswer":"c","explanation":"设原价 x 元，九折后为 0.9x 元，因此 0.9x＝108，解得 x＝120。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r06","knowledgePointId":"g7u-c5-applications","capabilityTag":"列式建模","difficulty":"advanced","responseType":"true-false","prompt":"已知 n 为偶数，比它大的下一个偶数可以表示为 n＋2。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"相邻两个偶数相差 2，在偶数 n 的基础上加 2 就得到下一个偶数。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r07","knowledgePointId":"g7u-c5-applications","capabilityTag":"行程关系","difficulty":"advanced","responseType":"single-choice","prompt":"甲在乙前方 3 km，两人同时沿同一直路同向前进，甲速 4 km/h，乙速 5.5 km/h，均保持不变。乙几小时后追上甲？","options":[{"id":"a","text":"1 小时"},{"id":"b","text":"2 小时"},{"id":"c","text":"3 小时"},{"id":"d","text":"4.5 小时"}],"correctAnswer":"b","explanation":"设追及时间为 t 小时，乙比甲多走 3 km，5.5t－4t＝3，得 1.5t＝3，所以 t＝2。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r08","knowledgePointId":"g7u-c5-applications","capabilityTag":"列式建模","difficulty":"challenge","responseType":"multi-choice","prompt":"水桶原有 12 L 水，以每分钟 3 L 的速度注水，没有漏水。注水 x 分钟后共有 30 L 水，可列哪些正确方程？（多选）","options":[{"id":"a","text":"12＋3x＝30"},{"id":"b","text":"3x＝18"},{"id":"c","text":"12x＋3＝30"},{"id":"d","text":"3x＝30"}],"correctAnswer":["a","b"],"explanation":"新增水量是 3x L，原有量加新增量等于 30 L，即 12＋3x＝30，也就是 3x＝18。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r09","knowledgePointId":"g7u-c5-applications","capabilityTag":"综合应用","difficulty":"challenge","responseType":"single-choice","prompt":"同一项工作，甲、乙单独完成都需要 8 小时。两人同时合作，效率不变且互不影响，完成工作需要多少小时？","options":[{"id":"a","text":"2 小时"},{"id":"b","text":"4 小时"},{"id":"c","text":"8 小时"},{"id":"d","text":"16 小时"}],"correctAnswer":"b","explanation":"设合作 x 小时，把全部工作看成 1，则 x/8＋x/8＝1，即 x/4＝1，得 x＝4。","source":"local-reviewed"},
        {"id":"g7u-c5-applications-r10","knowledgePointId":"g7u-c5-applications","capabilityTag":"综合应用","difficulty":"challenge","responseType":"single-choice","prompt":"活动成人票每张 15 元，学生票每张 10 元。共卖出 12 张票，收入 150 元，成人票卖出多少张？","options":[{"id":"a","text":"3 张"},{"id":"b","text":"4 张"},{"id":"c","text":"6 张"},{"id":"d","text":"9 张"}],"correctAnswer":"c","explanation":"设成人票 x 张，学生票 12－x 张，15x＋10(12－x)＝150，得 5x＝30，所以 x＝6。","source":"local-reviewed"}
      ]
