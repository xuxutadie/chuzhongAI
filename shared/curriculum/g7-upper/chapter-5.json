      "questions":[
        {"id":"g7u-c5-transform-d01","knowledgePointId":"g7u-c5-transform","capabilityTag":"去括号","difficulty":"basic","responseType":"single-choice","prompt":"方程 2(x－3)＝10 的解是多少？","options":[{"id":"a","text":"x＝2"},{"id":"b","text":"x＝5"},{"id":"c","text":"x＝8"},{"id":"d","text":"x＝13"}],"correctAnswer":"c","explanation":"两边先除以 2 得 x－3＝5，再加 3，得到 x＝8。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d02","knowledgePointId":"g7u-c5-transform","capabilityTag":"去分母","difficulty":"basic","responseType":"single-choice","prompt":"方程（x＋1）/3＝4 的解是多少？","options":[{"id":"a","text":"x＝3"},{"id":"b","text":"x＝11"},{"id":"c","text":"x＝12"},{"id":"d","text":"x＝13"}],"correctAnswer":"b","explanation":"两边乘 3 得 x＋1＝12，再减 1，得到 x＝11。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d03","knowledgePointId":"g7u-c5-transform","capabilityTag":"符号辨析","difficulty":"basic","responseType":"true-false","prompt":"去括号：－(x－2)＝－x－2。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"括号前的负号使括号内两项都变号，正确结果是－x＋2。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d04","knowledgePointId":"g7u-c5-transform","capabilityTag":"去分母","difficulty":"advanced","responseType":"multi-choice","prompt":"对方程（x－1）/2＋x/3＝1 去分母并整理，哪些等式正确？（多选）","options":[{"id":"a","text":"3(x－1)＋2x＝6"},{"id":"b","text":"5x－3＝6"},{"id":"c","text":"3x－3＋2x＝1"},{"id":"d","text":"x－1＋2x＝6"}],"correctAnswer":["a","b"],"explanation":"两边每一项乘 6，得到 3(x－1)＋2x＝6，展开合并得 5x－3＝6。右边和分子都不能漏乘。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d05","knowledgePointId":"g7u-c5-transform","capabilityTag":"去括号","difficulty":"advanced","responseType":"single-choice","prompt":"方程 3(x＋2)－2(x－1)＝13 的解是多少？","options":[{"id":"a","text":"x＝3"},{"id":"b","text":"x＝5"},{"id":"c","text":"x＝9"},{"id":"d","text":"x＝21"}],"correctAnswer":"b","explanation":"展开得 3x＋6－2x＋2＝13，合并为 x＋8＝13，所以 x＝5。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d06","knowledgePointId":"g7u-c5-transform","capabilityTag":"去分母","difficulty":"advanced","responseType":"true-false","prompt":"将 x/2＋1＝3 两边乘 2，可得到 x＋1＝6。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"左边常数 1 也要乘 2，正确结果是 x＋2＝6，不能漏乘常数项。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d07","knowledgePointId":"g7u-c5-transform","capabilityTag":"综合求解","difficulty":"advanced","responseType":"single-choice","prompt":"方程（x＋3）/2－（x－1）/4＝4 的解是多少？","options":[{"id":"a","text":"x＝7"},{"id":"b","text":"x＝8"},{"id":"c","text":"x＝9"},{"id":"d","text":"x＝11"}],"correctAnswer":"c","explanation":"两边乘 4 得 2(x＋3)－(x－1)＝16，展开为 x＋7＝16，所以 x＝9。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d08","knowledgePointId":"g7u-c5-transform","capabilityTag":"符号辨析","difficulty":"challenge","responseType":"multi-choice","prompt":"下列去括号结果中，哪些对任意 x 都正确？（多选）","options":[{"id":"a","text":"2(x－3)＝2x－6"},{"id":"b","text":"－3(x＋1)＝－3x－3"},{"id":"c","text":"5－(2x－1)＝6－2x"},{"id":"d","text":"－(x－4)＝－x－4"}],"correctAnswer":["a","b","c"],"explanation":"前两式按分配律展开；第三式为 5－2x＋1＝6－2x；第四式应是－x＋4。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d09","knowledgePointId":"g7u-c5-transform","capabilityTag":"综合求解","difficulty":"challenge","responseType":"single-choice","prompt":"方程（2x－1）/3＝（x＋2）/2 的解是多少？","options":[{"id":"a","text":"x＝4"},{"id":"b","text":"x＝6"},{"id":"c","text":"x＝8"},{"id":"d","text":"x＝10"}],"correctAnswer":"c","explanation":"两边乘 6 得 2(2x－1)＝3(x＋2)，即 4x－2＝3x＋6，解得 x＝8。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-d10","knowledgePointId":"g7u-c5-transform","capabilityTag":"综合求解","difficulty":"challenge","responseType":"single-choice","prompt":"方程 0.2(x＋5)＝0.5(x－1) 的解是多少？","options":[{"id":"a","text":"x＝3"},{"id":"b","text":"x＝5"},{"id":"c","text":"x＝7"},{"id":"d","text":"x＝15"}],"correctAnswer":"b","explanation":"两边乘 10 得 2(x＋5)＝5(x－1)，展开得 2x＋10＝5x－5，整理得 3x＝15，故 x＝5。","source":"local-reviewed"}
      ],
