        {"id":"g7u-c5-transform-r02","knowledgePointId":"g7u-c5-transform","capabilityTag":"去分母","difficulty":"basic","responseType":"single-choice","prompt":"方程（y－2）/4＝3 的解是多少？","options":[{"id":"a","text":"y＝10"},{"id":"b","text":"y＝12"},{"id":"c","text":"y＝14"},{"id":"d","text":"y＝20"}],"correctAnswer":"c","explanation":"两边乘 4 得 y－2＝12，再加 2，得到 y＝14。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r03","knowledgePointId":"g7u-c5-transform","capabilityTag":"符号辨析","difficulty":"basic","responseType":"true-false","prompt":"对任意 y，都有 2－(y＋3)＝－y－1。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"去括号后为 2－y－3，合并常数得－y－1，所以等式成立。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r04","knowledgePointId":"g7u-c5-transform","capabilityTag":"去分母","difficulty":"advanced","responseType":"multi-choice","prompt":"对方程（y＋2）/3＋y/2＝4 去分母并整理，哪些等式正确？（多选）","options":[{"id":"a","text":"2(y＋2)＋3y＝24"},{"id":"b","text":"5y＋4＝24"},{"id":"c","text":"2(y＋2)＋3y＝4"},{"id":"d","text":"y＋2＋3y＝24"}],"correctAnswer":["a","b"],"explanation":"最小公倍数为 6，全部项乘 6 得 2(y＋2)＋3y＝24，去括号合并得 5y＋4＝24。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r05","knowledgePointId":"g7u-c5-transform","capabilityTag":"去括号","difficulty":"advanced","responseType":"single-choice","prompt":"方程 4(y－1)－3(y＋2)＝2 的解是多少？","options":[{"id":"a","text":"y＝－8"},{"id":"b","text":"y＝4"},{"id":"c","text":"y＝8"},{"id":"d","text":"y＝12"}],"correctAnswer":"d","explanation":"展开得 4y－4－3y－6＝2，整理为 y－10＝2，因此 y＝12。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r06","knowledgePointId":"g7u-c5-transform","capabilityTag":"去分母","difficulty":"advanced","responseType":"true-false","prompt":"将（y＋1）/2＝3 两边乘 2，得到 y＋2＝6。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"分子整体与分母 2 约去，得到的是 y＋1＝6，不是把分子中的 1 单独再乘 2。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r07","knowledgePointId":"g7u-c5-transform","capabilityTag":"综合求解","difficulty":"advanced","responseType":"single-choice","prompt":"方程（y＋4）/3－（y－2）/6＝3 的解是多少？","options":[{"id":"a","text":"y＝6"},{"id":"b","text":"y＝8"},{"id":"c","text":"y＝10"},{"id":"d","text":"y＝12"}],"correctAnswer":"b","explanation":"两边乘 6 得 2(y＋4)－(y－2)＝18，即 y＋10＝18，所以 y＝8。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r08","knowledgePointId":"g7u-c5-transform","capabilityTag":"符号辨析","difficulty":"challenge","responseType":"multi-choice","prompt":"下列等式中，哪些对任意 y 都成立？（多选）","options":[{"id":"a","text":"5(y＋2)＝5y＋10"},{"id":"b","text":"－2(y－3)＝－2y＋6"},{"id":"c","text":"3－(y－2)＝5－y"},{"id":"d","text":"－(2y＋1)＝－2y＋1"}],"correctAnswer":["a","b","c"],"explanation":"分配律与负号变号可验证前三式成立，第四式括号内的＋1 应变为－1。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r09","knowledgePointId":"g7u-c5-transform","capabilityTag":"综合求解","difficulty":"challenge","responseType":"single-choice","prompt":"方程（3y＋1）/4＝（y＋5）/2 的解是多少？","options":[{"id":"a","text":"y＝4"},{"id":"b","text":"y＝6"},{"id":"c","text":"y＝9"},{"id":"d","text":"y＝11"}],"correctAnswer":"c","explanation":"两边乘 4 得 3y＋1＝2(y＋5)，展开移项得 y＝10－1＝9。","source":"local-reviewed"},
        {"id":"g7u-c5-transform-r10","knowledgePointId":"g7u-c5-transform","capabilityTag":"综合求解","difficulty":"challenge","responseType":"single-choice","prompt":"方程 0.3(y－2)＝0.2(y＋3) 的解是多少？","options":[{"id":"a","text":"y＝6"},{"id":"b","text":"y＝8"},{"id":"c","text":"y＝10"},{"id":"d","text":"y＝12"}],"correctAnswer":"d","explanation":"两边乘 10 得 3(y－2)＝2(y＋3)，展开为 3y－6＝2y＋6，所以 y＝12。","source":"local-reviewed"}
