      "id":"g7u-c5-transform", "subject":"数学", "grade":7, "semester":"上册", "textbookVersion":"北师大版", "chapterId":"g7u-chapter-5", "title":"去括号与去分母解方程", "lessonId":"g7-upper-equations", "learningMode":"explanation",
