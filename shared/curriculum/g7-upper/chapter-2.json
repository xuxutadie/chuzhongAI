        {"id":"g7u-c2-addition-r07","knowledgePointId":"g7u-c2-addition","capabilityTag":"加减法则","difficulty":"advanced","responseType":"multi-choice","prompt":"下列计算中，哪些结果正确？","options":[{"id":"a","text":"−8 + 3 = 5"},{"id":"b","text":"4 − 9 = −5"},{"id":"c","text":"−7 − (−7) = 0"},{"id":"d","text":"−1 + 6 = 5"}],"correctAnswer":["b","c","d"],"explanation":"A 的结果应为 −5；B、C、D 分别等于 −5、0、5，均正确。","source":"local-reviewed"},
        {"id":"g7u-c2-addition-r08","knowledgePointId":"g7u-c2-addition","capabilityTag":"加减法则","difficulty":"challenge","responseType":"single-choice","prompt":"计算 −5/6 + 1/3 − (−1/2)。","options":[{"id":"a","text":"−1"},{"id":"b","text":"1"},{"id":"c","text":"0"},{"id":"d","text":"−1/3"}],"correctAnswer":"c","explanation":"通分得 −5/6 + 2/6 + 3/6 = 0。","source":"local-reviewed"},
