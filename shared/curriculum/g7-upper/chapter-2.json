        {"id":"g7u-c2-powers-r03","knowledgePointId":"g7u-c2-powers","capabilityTag":"乘方意义","difficulty":"basic","responseType":"true-false","prompt":"3³ = 3 × 3 × 3 = 27。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"指数 3 表示底数 3 作为因数连续相乘三次。","source":"local-reviewed"},
        {"id":"g7u-c2-powers-r04","knowledgePointId":"g7u-c2-powers","capabilityTag":"运算顺序","difficulty":"basic","responseType":"single-choice","prompt":"计算 20 − 3 × 4。","options":[{"id":"a","text":"8"},{"id":"b","text":"68"},{"id":"c","text":"32"},{"id":"d","text":"17"}],"correctAnswer":"a","explanation":"先算 3 × 4 = 12，再算 20 − 12 = 8。","source":"local-reviewed"},
        {"id":"g7u-c2-powers-r05","knowledgePointId":"g7u-c2-powers","capabilityTag":"运算顺序","difficulty":"advanced","responseType":"single-choice","prompt":"计算 32 ÷ (−2)⁴。","options":[{"id":"a","text":"−2"},{"id":"b","text":"4"},{"id":"c","text":"2"},{"id":"d","text":"−16"}],"correctAnswer":"c","explanation":"(−2)⁴ = 16，32 ÷ 16 = 2。","source":"local-reviewed"},
        {"id":"g7u-c2-powers-r06","knowledgePointId":"g7u-c2-powers","capabilityTag":"科学记数法","difficulty":"advanced","responseType":"single-choice","prompt":"503000 用规范的科学记数法表示是哪一个？","options":[{"id":"a","text":"50.3 × 10⁴"},{"id":"b","text":"5.03 × 10⁵"},{"id":"c","text":"0.503 × 10⁶"},{"id":"d","text":"5.03 × 10⁴"}],"correctAnswer":"b","explanation":"503000 = 5.03 × 100000 = 5.03 × 10⁵，首因数满足 1 ≤ 5.03 < 10。","source":"local-reviewed"},
