        {"id":"g7u-c2-rational-r02","knowledgePointId":"g7u-c2-rational","capabilityTag":"数的分类","difficulty":"basic","responseType":"true-false","prompt":"−3/4 是有理数，但不是整数。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"−3/4 是负分数，分数属于有理数，它的数值不是整数。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r03","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"basic","responseType":"single-choice","prompt":"5.2 的相反数是多少？","options":[{"id":"a","text":"−5.2"},{"id":"b","text":"5.2"},{"id":"c","text":"0"},{"id":"d","text":"1/5.2"}],"correctAnswer":"a","explanation":"只改变数的符号，得到相反数 −5.2。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r04","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"basic","responseType":"single-choice","prompt":"|−9| 的值是多少？","options":[{"id":"a","text":"−9"},{"id":"b","text":"−1/9"},{"id":"c","text":"0"},{"id":"d","text":"9"}],"correctAnswer":"d","explanation":"−9 到数轴原点的距离是 9，因此绝对值是 9。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r05","knowledgePointId":"g7u-c2-rational","capabilityTag":"数轴与大小","difficulty":"advanced","responseType":"single-choice","prompt":"数轴上，表示 3 的点向左移动 7 个单位长度，表示的数是多少？","options":[{"id":"a","text":"10"},{"id":"b","text":"−4"},{"id":"c","text":"4"},{"id":"d","text":"−10"}],"correctAnswer":"b","explanation":"向左移动使数值减小，3 − 7 = −4。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r06","knowledgePointId":"g7u-c2-rational","capabilityTag":"数轴与大小","difficulty":"advanced","responseType":"true-false","prompt":"−0.6 比 −0.2 小。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"0.6 > 0.2，两负数中绝对值较大的 −0.6 较小。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r07","knowledgePointId":"g7u-c2-rational","capabilityTag":"数的分类","difficulty":"advanced","responseType":"multi-choice","prompt":"下列数中，哪些是负有理数？","options":[{"id":"a","text":"−2"},{"id":"b","text":"0"},{"id":"c","text":"−1/5"},{"id":"d","text":"0.3"}],"correctAnswer":["a","c"],"explanation":"−2 是负整数，−1/5 是负分数；0 不是负数，0.3 为正数。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r08","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"challenge","responseType":"multi-choice","prompt":"若 |y| = 2.5，y 可以取哪些值？","options":[{"id":"a","text":"0"},{"id":"b","text":"−2.5"},{"id":"c","text":"5"},{"id":"d","text":"2.5"}],"correctAnswer":["b","d"],"explanation":"绝对值等于 2.5 的数是 −2.5 和 2.5。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r09","knowledgePointId":"g7u-c2-rational","capabilityTag":"数轴与大小","difficulty":"challenge","responseType":"single-choice","prompt":"−3/4、−1/4、−1、−2 中，最大的数是哪一个？","options":[{"id":"a","text":"−3/4"},{"id":"b","text":"−1"},{"id":"c","text":"−1/4"},{"id":"d","text":"−2"}],"correctAnswer":"c","explanation":"四个数都是负数，−1/4 的绝对值最小，所以它最大。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-r10","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"challenge","responseType":"true-false","prompt":"若 |a| = 0，那么 a 的相反数也一定是 0。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"绝对值为 0 的数只能是 0，而 0 的相反数仍为 0。","source":"local-reviewed"}
