      "id": "g7u-c2-rational", "subject": "数学", "grade": 7, "semester": "上册", "textbookVersion": "北师大版", "chapterId": "g7u-chapter-2", "title": "认识有理数、数轴与绝对值", "lessonId": "g7-upper-integers", "learningMode": "explanation",
      "capabilityTags": ["数的分类", "数轴与大小", "相反数与绝对值"],
      "learningGuide": {"steps": ["先确定实际情境中零点和正方向，例如把收入记为正数，支出记为负数。", "整数与分数统称有理数；0 是整数，既不是正数也不是负数。", "数轴上向右数值增大。两负数比较时，绝对值大的反而小。", "两个非零数若符号相反、绝对值相等，就互为相反数；0 的相反数仍是 0。绝对值表示到原点的距离，不能为负。例如 −5 的相反数是 5，绝对值也是 5。"], "pitfalls": ["不要把 0 漏出整数集合，也不要把负分数归为整数。", "−8 小于 −3，不是因为 8 大就判 −8 大。", "|x| = a 且 a > 0 时恰有正、负两个解；|x| = 0 时只有 x = 0。"]},
      "questions": [
        {"id":"g7u-c2-rational-d01","knowledgePointId":"g7u-c2-rational","capabilityTag":"数的分类","difficulty":"basic","responseType":"single-choice","prompt":"若收入记为正数，支出 30 元应记为多少元？","options":[{"id":"a","text":"30"},{"id":"b","text":"−30"},{"id":"c","text":"0"},{"id":"d","text":"−3"}],"correctAnswer":"b","explanation":"支出与收入方向相反，因此记为 −30 元。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d02","knowledgePointId":"g7u-c2-rational","capabilityTag":"数的分类","difficulty":"basic","responseType":"true-false","prompt":"0 是整数，但既不是正数也不是负数。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"整数包括正整数、0 和负整数；正负数的分类中 0 单独考虑。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d03","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"basic","responseType":"single-choice","prompt":"−7 的相反数是多少？","options":[{"id":"a","text":"−7"},{"id":"b","text":"1/7"},{"id":"c","text":"7"},{"id":"d","text":"−1/7"}],"correctAnswer":"c","explanation":"相反数相加得 0，−7 + 7 = 0。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d04","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"basic","responseType":"single-choice","prompt":"|−3.5| 的值是多少？","options":[{"id":"a","text":"3.5"},{"id":"b","text":"−3.5"},{"id":"c","text":"0"},{"id":"d","text":"7"}],"correctAnswer":"a","explanation":"绝对值是到原点的距离，−3.5 到原点的距离是 3.5。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d05","knowledgePointId":"g7u-c2-rational","capabilityTag":"数轴与大小","difficulty":"advanced","responseType":"single-choice","prompt":"数轴上，表示 −2 的点向右移动 5 个单位长度，表示的数是多少？","options":[{"id":"a","text":"−7"},{"id":"b","text":"7"},{"id":"c","text":"−3"},{"id":"d","text":"3"}],"correctAnswer":"d","explanation":"向右移动使数值增加，−2 + 5 = 3。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d06","knowledgePointId":"g7u-c2-rational","capabilityTag":"数轴与大小","difficulty":"advanced","responseType":"true-false","prompt":"因为 8 > 3，所以 −8 > −3。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"两负数比较，绝对值大的反而小，因此 −8 < −3。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d07","knowledgePointId":"g7u-c2-rational","capabilityTag":"数的分类","difficulty":"advanced","responseType":"multi-choice","prompt":"下列数中，哪些是整数？","options":[{"id":"a","text":"−4"},{"id":"b","text":"0"},{"id":"c","text":"2/3"},{"id":"d","text":"6"}],"correctAnswer":["a","b","d"],"explanation":"−4、0、6 都是整数，2/3 是分数但不是整数。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d08","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"challenge","responseType":"multi-choice","prompt":"若 |x| = 4，x 可以取哪些值？","options":[{"id":"a","text":"−4"},{"id":"b","text":"0"},{"id":"c","text":"4"},{"id":"d","text":"8"}],"correctAnswer":["a","c"],"explanation":"到原点距离为 4 的点有两个，分别表示 −4 和 4。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d09","knowledgePointId":"g7u-c2-rational","capabilityTag":"数轴与大小","difficulty":"challenge","responseType":"single-choice","prompt":"−1/2、−2/3、0、1/4 中，最小的数是哪一个？","options":[{"id":"a","text":"−1/2"},{"id":"b","text":"−2/3"},{"id":"c","text":"0"},{"id":"d","text":"1/4"}],"correctAnswer":"b","explanation":"负数比 0 和正数小；2/3 > 1/2，所以 −2/3 < −1/2。","source":"local-reviewed"},
        {"id":"g7u-c2-rational-d10","knowledgePointId":"g7u-c2-rational","capabilityTag":"相反数与绝对值","difficulty":"challenge","responseType":"true-false","prompt":"若 a、b 都是负数，且 |a| = |b|，那么 a = b。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"两数同为负数，绝对值又相同，必然表示数轴上同一个点。","source":"local-reviewed"}
      ],
