        {"id":"g7u-c2-multiplication-r02","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"乘除法则","difficulty":"basic","responseType":"single-choice","prompt":"计算 42 ÷ (−6)。","options":[{"id":"a","text":"−7"},{"id":"b","text":"7"},{"id":"c","text":"−36"},{"id":"d","text":"36"}],"correctAnswer":"a","explanation":"异号相除为负，42 ÷ 6 = 7，结果为 −7。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r03","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"倒数","difficulty":"basic","responseType":"single-choice","prompt":"−5 的倒数是多少？","options":[{"id":"a","text":"5"},{"id":"b","text":"1/5"},{"id":"c","text":"−5"},{"id":"d","text":"−1/5"}],"correctAnswer":"d","explanation":"(−5) × (−1/5) = 1，所以倒数是 −1/5。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r04","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"倒数","difficulty":"basic","responseType":"true-false","prompt":"−1 的倒数仍是 −1。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"(−1) × (−1) = 1，所以 −1 与它自身互为倒数。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r05","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"乘除法则","difficulty":"advanced","responseType":"single-choice","prompt":"计算 (−5/6) ÷ (−5/3)。","options":[{"id":"a","text":"−1/2"},{"id":"b","text":"1/2"},{"id":"c","text":"2"},{"id":"d","text":"25/18"}],"correctAnswer":"b","explanation":"同号相除为正，(5/6) × (3/5) = 1/2。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r06","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"乘除法则","difficulty":"advanced","responseType":"true-false","prompt":"五个负数相乘，积一定是正数。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"负因数有五个，是奇数个，因此积为负。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r07","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"乘除法则","difficulty":"advanced","responseType":"multi-choice","prompt":"下列计算中，哪些正确？","options":[{"id":"a","text":"(−9) ÷ (−3) = −3"},{"id":"b","text":"(−4) × 0 = 0"},{"id":"c","text":"15 ÷ (−5) = −3"},{"id":"d","text":"(−2) × (−7) = 14"}],"correctAnswer":["b","c","d"],"explanation":"A 应为正 3；B 为零乘法，C 为异号相除，D 为同号相乘，均正确。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r08","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"运算律","difficulty":"challenge","responseType":"single-choice","prompt":"计算 (−18) × (1/2 − 1/3)。","options":[{"id":"a","text":"−3"},{"id":"b","text":"3"},{"id":"c","text":"−15"},{"id":"d","text":"15"}],"correctAnswer":"a","explanation":"分配计算为 −9 + 6 = −3，也可先算括号为 1/6。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r09","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"乘除法则","difficulty":"challenge","responseType":"single-choice","prompt":"计算 (−24) ÷ (−3) × (−2)。","options":[{"id":"a","text":"−4"},{"id":"b","text":"4"},{"id":"c","text":"16"},{"id":"d","text":"−16"}],"correctAnswer":"d","explanation":"乘除同级，从左到右计算：先得 8，再乘 −2，结果为 −16。","source":"local-reviewed"},
        {"id":"g7u-c2-multiplication-r10","knowledgePointId":"g7u-c2-multiplication","capabilityTag":"运算律","difficulty":"challenge","responseType":"multi-choice","prompt":"下列改写中，哪些正确？","options":[{"id":"a","text":"(−7) × 99 = (−7) × 100 + 7"},{"id":"b","text":"(−7) × 99 = (−7) × 100 − 7"},{"id":"c","text":"(−6) × (2 − 5) = −12 + 30"},{"id":"d","text":"(−6) × (2 − 5) = −12 − 30"}],"correctAnswer":["a","c"],"explanation":"99 = 100 − 1，乘 −7 得 −700 + 7；(−6) × (−5) = 30，所以第二个式子为 −12 + 30。","source":"local-reviewed"}
