      "id": "g7u-c4-lines", "subject": "数学", "grade": 7, "semester": "上册", "textbookVersion": "北师大版", "chapterId": "g7u-chapter-4", "title": "线段、射线与直线", "lessonId": "g7-upper-plane-figures", "learningMode": "explanation",
      "capabilityTags": ["对象辨认", "表示方法", "点线关系", "线段计数"],
      "learningGuide": {
        "steps": ["先看端点和延伸方向：线段有两个端点，射线有一个端点并向一个方向无限延伸，直线没有端点并向两个方向无限延伸。", "用两个字母表示射线时，首字母必须是端点；直线 AB 与直线 BA 相同，线段 AB 与线段 BA 也相同，但射线 AB 与射线 BA 不同。", "经过两个不同的点有且只有一条直线；只有一个点时不能唯一确定直线。", "数同一直线上的线段时，每选两个不同的已知点就确定一条线段。例如三个点 A、B、C 确定 AB、AC、BC 三条线段。"],
        "pitfalls": ["图上画出的直线和射线长度有限，但它们表示的几何对象无限延伸，不能比较其长度。", "两条射线是否相同要同时检查端点和方向，仅仅在同一条直线上还不够。"]
      },
      "questions": [
        {"id":"g7u-c4-lines-d01","knowledgePointId":"g7u-c4-lines","capabilityTag":"对象辨认","difficulty":"basic","responseType":"single-choice","prompt":"下列哪一种几何对象有两个端点？","options":[{"id":"a","text":"直线"},{"id":"b","text":"射线"},{"id":"c","text":"线段"},{"id":"d","text":"圆"}],"correctAnswer":"c","explanation":"线段有两个端点；射线有一个端点，直线没有端点。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d02","knowledgePointId":"g7u-c4-lines","capabilityTag":"对象辨认","difficulty":"basic","responseType":"single-choice","prompt":"把线段 AB 从端点 B 向外无限延伸，保留 A 为端点，得到什么？","options":[{"id":"a","text":"射线 AB"},{"id":"b","text":"射线 BA"},{"id":"c","text":"直线 AB"},{"id":"d","text":"线段 AB"}],"correctAnswer":"a","explanation":"延伸后只有 A 一个端点，方向从 A 经过 B，因此是射线 AB。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d03","knowledgePointId":"g7u-c4-lines","capabilityTag":"点线关系","difficulty":"basic","responseType":"true-false","prompt":"经过两个不同的点，有且只有一条直线。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"两个不同的点能够唯一确定一条直线，这是直线的基本事实。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d04","knowledgePointId":"g7u-c4-lines","capabilityTag":"表示方法","difficulty":"advanced","responseType":"multi-choice","prompt":"A、B 是两个不同的点，下列说法哪些正确？（多选）","options":[{"id":"a","text":"线段 AB 与线段 BA 是同一条线段"},{"id":"b","text":"直线 AB 与直线 BA 是同一条直线"},{"id":"c","text":"射线 AB 与射线 BA 是同一条射线"},{"id":"d","text":"射线 AB 的端点是 A"}],"correctAnswer":["a","b","d"],"explanation":"线段、直线的两个字母可交换；射线的首字母指定端点，AB 与 BA 的端点不同。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d05","knowledgePointId":"g7u-c4-lines","capabilityTag":"点线关系","difficulty":"advanced","responseType":"single-choice","prompt":"经过平面内一个已知点，可以画多少条不同的直线？","options":[{"id":"a","text":"0 条"},{"id":"b","text":"1 条"},{"id":"c","text":"2 条"},{"id":"d","text":"无数条"}],"correctAnswer":"d","explanation":"只固定一个点，直线的方向仍可任意改变，所以可以画无数条。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d06","knowledgePointId":"g7u-c4-lines","capabilityTag":"表示方法","difficulty":"advanced","responseType":"true-false","prompt":"同一直线上依次排列着三个不同的点 A、B、C，射线 AB 与射线 AC 是同一条射线。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"两条射线都以 A 为端点，而且 B、C 在 A 的同一侧，因此方向相同。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d07","knowledgePointId":"g7u-c4-lines","capabilityTag":"线段计数","difficulty":"advanced","responseType":"single-choice","prompt":"同一直线上有 A、B、C 三个不同的点，以其中任意两个点为端点，一共能确定多少条不同的线段？","options":[{"id":"a","text":"2 条"},{"id":"b","text":"3 条"},{"id":"c","text":"4 条"},{"id":"d","text":"6 条"}],"correctAnswer":"b","explanation":"可以确定 AB、AC、BC 三条线段，线段 AB 与 BA 不能重复计数。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d08","knowledgePointId":"g7u-c4-lines","capabilityTag":"表示方法","difficulty":"challenge","responseType":"multi-choice","prompt":"同一直线上依次排列着不同的点 A、B、C、D。下列哪些射线与射线 BC 相同？（多选）","options":[{"id":"a","text":"射线 BD"},{"id":"b","text":"射线 BA"},{"id":"c","text":"从 B 出发经过 C 并继续无限延伸的射线"},{"id":"d","text":"射线 CD"}],"correctAnswer":["a","c"],"explanation":"与 BC 相同的射线必须以 B 为端点并指向 C、D 所在的一侧，BA 方向相反，CD 端点不同。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d09","knowledgePointId":"g7u-c4-lines","capabilityTag":"线段计数","difficulty":"challenge","responseType":"single-choice","prompt":"同一直线上标有四个不同的点，以其中任意两个点为端点，可以确定多少条不同的线段？","options":[{"id":"a","text":"4 条"},{"id":"b","text":"5 条"},{"id":"c","text":"6 条"},{"id":"d","text":"8 条"}],"correctAnswer":"c","explanation":"从左到右逐个选左端点，分别可配 3、2、1 个右端点，共 3＋2＋1＝6 条。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-d10","knowledgePointId":"g7u-c4-lines","capabilityTag":"点线关系","difficulty":"challenge","responseType":"single-choice","prompt":"平面内三点 A、B、C 不在同一条直线上，每两点确定一条直线，共得到多少条不同的直线？","options":[{"id":"a","text":"1 条"},{"id":"b","text":"2 条"},{"id":"c","text":"3 条"},{"id":"d","text":"6 条"}],"correctAnswer":"c","explanation":"直线 AB、AC、BC 各不相同；如果其中两条重合，三个点就会共线，与条件矛盾。","source":"local-reviewed"}
      ],
      "retestQuestions": [
        {"id":"g7u-c4-lines-r01","knowledgePointId":"g7u-c4-lines","capabilityTag":"对象辨认","difficulty":"basic","responseType":"single-choice","prompt":"有一个端点、向一个方向无限延伸的几何对象是什么？","options":[{"id":"a","text":"线段"},{"id":"b","text":"射线"},{"id":"c","text":"直线"},{"id":"d","text":"三角形"}],"correctAnswer":"b","explanation":"一个端点和单方向无限延伸，是射线区别于线段、直线的特征。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r02","knowledgePointId":"g7u-c4-lines","capabilityTag":"对象辨认","difficulty":"basic","responseType":"single-choice","prompt":"把线段 MN 向两个方向无限延伸，得到什么？","options":[{"id":"a","text":"线段 MN"},{"id":"b","text":"射线 MN"},{"id":"c","text":"射线 NM"},{"id":"d","text":"直线 MN"}],"correctAnswer":"d","explanation":"向两端无限延伸后不再有端点，得到的是直线 MN。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r03","knowledgePointId":"g7u-c4-lines","capabilityTag":"对象辨认","difficulty":"basic","responseType":"true-false","prompt":"射线向一个方向无限延伸，所以可以用刻度尺测出它的总长度。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"无限延伸意味着不存在有限的总长度，刻度尺只能测量其中有限线段的长度。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r04","knowledgePointId":"g7u-c4-lines","capabilityTag":"对象辨认","difficulty":"advanced","responseType":"multi-choice","prompt":"下列关于端点的说法，哪些正确？（多选）","options":[{"id":"a","text":"线段有两个端点"},{"id":"b","text":"射线有一个端点"},{"id":"c","text":"直线有两个端点"},{"id":"d","text":"直线没有端点"}],"correctAnswer":["a","b","d"],"explanation":"线段、射线、直线的端点数依次为 2、1、0，纸上画出的直线两端不是几何端点。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r05","knowledgePointId":"g7u-c4-lines","capabilityTag":"表示方法","difficulty":"advanced","responseType":"single-choice","prompt":"M、N 是两个不同的点，用两个字母表示射线 NM 时，它的端点是哪一个？","options":[{"id":"a","text":"M"},{"id":"b","text":"N"},{"id":"c","text":"M、N 都是"},{"id":"d","text":"没有端点"}],"correctAnswer":"b","explanation":"射线的首字母表示端点，所以射线 NM 从 N 出发，经过 M。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r06","knowledgePointId":"g7u-c4-lines","capabilityTag":"点线关系","difficulty":"advanced","responseType":"true-false","prompt":"如果两条直线都经过不同的点 P 和 Q，那么这两条直线必定重合。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"经过 P、Q 两个不同点的直线唯一，因此这两条直线实际上是同一条。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r07","knowledgePointId":"g7u-c4-lines","capabilityTag":"表示方法","difficulty":"advanced","responseType":"single-choice","prompt":"同一直线上三个不同的点依次为 P、Q、R，射线 QP 与射线 QR 的关系是什么？","options":[{"id":"a","text":"端点相同，方向相反"},{"id":"b","text":"端点相同，方向相同"},{"id":"c","text":"端点不同，方向相同"},{"id":"d","text":"完全重合"}],"correctAnswer":"a","explanation":"两条射线都从 Q 出发，而 P、R 在 Q 的两侧，所以方向相反。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r08","knowledgePointId":"g7u-c4-lines","capabilityTag":"表示方法","difficulty":"challenge","responseType":"multi-choice","prompt":"同一直线上依次排列着不同的点 P、Q、R。下列哪些说法正确？（多选）","options":[{"id":"a","text":"直线 PQ 与直线 PR 相同"},{"id":"b","text":"射线 PQ 与射线 PR 相同"},{"id":"c","text":"线段 PQ 与线段 PR 相同"},{"id":"d","text":"射线 QP 与射线 QR 相同"}],"correctAnswer":["a","b"],"explanation":"三个点共线，确定同一条直线；Q、R 在 P 同侧，故两条从 P 出发的射线相同。线段端点和另两条射线方向不同。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r09","knowledgePointId":"g7u-c4-lines","capabilityTag":"线段计数","difficulty":"challenge","responseType":"single-choice","prompt":"同一直线上有五个不同的点，以其中任意两个点为端点，共有多少条不同的线段？","options":[{"id":"a","text":"5 条"},{"id":"b","text":"8 条"},{"id":"c","text":"10 条"},{"id":"d","text":"20 条"}],"correctAnswer":"c","explanation":"依次选左端点，可配的右端点数为 4、3、2、1，共 4＋3＋2＋1＝10 条。","source":"local-reviewed"},
        {"id":"g7u-c4-lines-r10","knowledgePointId":"g7u-c4-lines","capabilityTag":"点线关系","difficulty":"challenge","responseType":"single-choice","prompt":"平面内有四个不同的点，任意三个点都不共线。每两点确定一条直线，共有多少条不同的直线？","options":[{"id":"a","text":"4 条"},{"id":"b","text":"6 条"},{"id":"c","text":"8 条"},{"id":"d","text":"12 条"}],"correctAnswer":"b","explanation":"四个点有 3＋2＋1＝6 种不重复的配对；任意三点不共线保证这些直线互不重合。","source":"local-reviewed"}
