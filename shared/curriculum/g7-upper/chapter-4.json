    {
      "id": "g7u-c4-segments", "subject": "数学", "grade": 7, "semester": "上册", "textbookVersion": "北师大版", "chapterId": "g7u-chapter-4", "title": "线段比较与中点", "lessonId": "g7-upper-plane-figures", "learningMode": "explanation",
      "capabilityTags": ["长度比较", "线段和差", "中点关系", "距离理解"],
      "learningGuide": {
        "steps": ["比较线段长短可以测量，也可以把一个端点和方向重合后比较另一个端点的位置。计算前先把长度单位统一。", "先根据文字条件写出点的顺序：如果 B 在线段 AC 内部，那么 AC＝AB＋BC；只有明确位置后才能使用加法或减法。", "M 是线段 AB 的中点意味着 M 在线段 AB 上且 AM＝MB＝AB÷2；反过来判定中点时也要同时检查位置与等长。", "两点之间的距离指连接这两点的线段长度。在连接两点的所有路径中，线段最短。"],
        "pitfalls": ["点在线段所在直线上，不等于点在线段内部；点的位置不同时，长度关系可能不同。", "中点公式中的一半是长度的一半，不要把整条线段和半条线段混用。"]
      },
      "questions": [
        {"id":"g7u-c4-segments-d01","knowledgePointId":"g7u-c4-segments","capabilityTag":"长度比较","difficulty":"basic","responseType":"single-choice","prompt":"线段 AB 长 3 cm，线段 CD 长 28 mm，哪一条更长？","options":[{"id":"a","text":"AB 更长"},{"id":"b","text":"CD 更长"},{"id":"c","text":"一样长"},{"id":"d","text":"无法比较"}],"correctAnswer":"a","explanation":"先统一单位，3 cm＝30 mm，大于 28 mm，所以 AB 更长。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d02","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"basic","responseType":"single-choice","prompt":"M 是线段 AB 的中点，AB＝14 cm，则 AM 等于多少？","options":[{"id":"a","text":"3.5 cm"},{"id":"b","text":"7 cm"},{"id":"c","text":"14 cm"},{"id":"d","text":"28 cm"}],"correctAnswer":"b","explanation":"中点把线段分成相等的两段，所以 AM＝AB÷2＝14÷2＝7 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d03","knowledgePointId":"g7u-c4-segments","capabilityTag":"距离理解","difficulty":"basic","responseType":"true-false","prompt":"两点之间的距离，是连接这两点的线段的长度。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"距离是一个长度数值，几何上用连接两点的线段长度来定义。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d04","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"advanced","responseType":"multi-choice","prompt":"M 是线段 AB 的中点，以下等式哪些成立？（多选）","options":[{"id":"a","text":"AM＝MB"},{"id":"b","text":"AB＝2AM"},{"id":"c","text":"AM＝2AB"},{"id":"d","text":"MB＝AB÷2"}],"correctAnswer":["a","b","d"],"explanation":"AM 与 MB 都是 AB 的一半，因此 AB＝2AM＝2MB，而不是 AM＝2AB。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d05","knowledgePointId":"g7u-c4-segments","capabilityTag":"线段和差","difficulty":"advanced","responseType":"single-choice","prompt":"点 A、B、C 在同一直线上依次排列，AB＝5 cm，BC＝8 cm，AC 等于多少？","options":[{"id":"a","text":"3 cm"},{"id":"b","text":"8 cm"},{"id":"c","text":"13 cm"},{"id":"d","text":"40 cm"}],"correctAnswer":"c","explanation":"B 在线段 AC 内部，所以 AC＝AB＋BC＝5＋8＝13 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d06","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"advanced","responseType":"true-false","prompt":"点 P 在线段 AB 上，且 AP＝PB，那么 P 是 AB 的中点。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"位于线段上并把它分成相等的两段，正好满足中点定义。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d07","knowledgePointId":"g7u-c4-segments","capabilityTag":"线段和差","difficulty":"advanced","responseType":"single-choice","prompt":"点 A、B、C 在同一直线上依次排列，AC＝17 cm，AB＝9 cm，则 BC 等于多少？","options":[{"id":"a","text":"8 cm"},{"id":"b","text":"9 cm"},{"id":"c","text":"17 cm"},{"id":"d","text":"26 cm"}],"correctAnswer":"a","explanation":"AC 由 AB 和 BC 组成，故 BC＝AC－AB＝17－9＝8 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d08","knowledgePointId":"g7u-c4-segments","capabilityTag":"线段和差","difficulty":"challenge","responseType":"multi-choice","prompt":"A、B、C 在同一直线上依次排列，AB＝4 cm，BC＝6 cm。以下结论哪些正确？（多选）","options":[{"id":"a","text":"AC＝10 cm"},{"id":"b","text":"B 是 AC 的中点"},{"id":"c","text":"AC 比 BC 长 4 cm"},{"id":"d","text":"AB 是 AC 的一半"}],"correctAnswer":["a","c"],"explanation":"AC＝4＋6＝10 cm，AC－BC＝4 cm；AB 与 BC 不相等，所以 B 不是中点。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d09","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"challenge","responseType":"single-choice","prompt":"M 是 AB 的中点，N 是 AM 的中点，AB＝20 cm，BN 等于多少？","options":[{"id":"a","text":"5 cm"},{"id":"b","text":"10 cm"},{"id":"c","text":"15 cm"},{"id":"d","text":"20 cm"}],"correctAnswer":"c","explanation":"点的顺序为 A、N、M、B。AM＝10，AN＝5，所以 BN＝AB－AN＝20－5＝15 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-d10","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"challenge","responseType":"single-choice","prompt":"A、B、C 在同一直线上依次排列，AB＝8 cm，BC＝12 cm。M、N 分别是 AB、BC 的中点，MN 等于多少？","options":[{"id":"a","text":"2 cm"},{"id":"b","text":"6 cm"},{"id":"c","text":"10 cm"},{"id":"d","text":"20 cm"}],"correctAnswer":"c","explanation":"点的顺序为 A、M、B、N、C。MB＝4，BN＝6，所以 MN＝MB＋BN＝10 cm。","source":"local-reviewed"}
      ],
      "retestQuestions": [
        {"id":"g7u-c4-segments-r01","knowledgePointId":"g7u-c4-segments","capabilityTag":"长度比较","difficulty":"basic","responseType":"single-choice","prompt":"线段 EF 长 4.2 cm，线段 GH 长 45 mm，比较结果是什么？","options":[{"id":"a","text":"EF 更长"},{"id":"b","text":"GH 更长"},{"id":"c","text":"一样长"},{"id":"d","text":"单位不同，不能比较"}],"correctAnswer":"b","explanation":"4.2 cm＝42 mm，小于 45 mm，因此 GH 更长。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r02","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"basic","responseType":"single-choice","prompt":"P 是 MN 的中点，MP＝9 cm，则 MN 长多少？","options":[{"id":"a","text":"4.5 cm"},{"id":"b","text":"9 cm"},{"id":"c","text":"18 cm"},{"id":"d","text":"27 cm"}],"correctAnswer":"c","explanation":"MP 是 MN 的一半，所以 MN＝2MP＝2×9＝18 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r03","knowledgePointId":"g7u-c4-segments","capabilityTag":"距离理解","difficulty":"basic","responseType":"true-false","prompt":"连接两个不同点的路径中，直线段比任何绕行的折线路径都短。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"两点之间线段最短；这里的绕行折线指并非沿同一线段直接到达的路径。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r04","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"advanced","responseType":"multi-choice","prompt":"P 是线段 MN 的中点，MN＝18 cm，哪些结论正确？（多选）","options":[{"id":"a","text":"MP＝9 cm"},{"id":"b","text":"PN＝9 cm"},{"id":"c","text":"MP＋PN＝18 cm"},{"id":"d","text":"MP＝18 cm"}],"correctAnswer":["a","b","c"],"explanation":"中点将 18 cm 平分为两个 9 cm，两段相加仍等于整段 18 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r05","knowledgePointId":"g7u-c4-segments","capabilityTag":"线段和差","difficulty":"advanced","responseType":"single-choice","prompt":"点 P、Q、R 在同一直线上依次排列，PQ＝7 cm，QR＝9 cm，则 PR 等于多少？","options":[{"id":"a","text":"2 cm"},{"id":"b","text":"9 cm"},{"id":"c","text":"14 cm"},{"id":"d","text":"16 cm"}],"correctAnswer":"d","explanation":"Q 位于 P、R 之间，所以 PR＝PQ＋QR＝7＋9＝16 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r06","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"advanced","responseType":"true-false","prompt":"点 C 在线段 AB 内部，只要 AC 小于 CB，C 就是 AB 的中点。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"中点要求 AC＝CB，只有位于线段内部而两段不相等时，不能称为中点。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r07","knowledgePointId":"g7u-c4-segments","capabilityTag":"线段和差","difficulty":"advanced","responseType":"single-choice","prompt":"点 P、Q、R 在同一直线上依次排列，PR＝25 cm，QR＝11 cm，则 PQ 等于多少？","options":[{"id":"a","text":"11 cm"},{"id":"b","text":"14 cm"},{"id":"c","text":"25 cm"},{"id":"d","text":"36 cm"}],"correctAnswer":"b","explanation":"PR＝PQ＋QR，所以 PQ＝PR－QR＝25－11＝14 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r08","knowledgePointId":"g7u-c4-segments","capabilityTag":"线段和差","difficulty":"challenge","responseType":"multi-choice","prompt":"不同的点 A、B、C 在同一直线上依次排列。哪些长度关系成立？（多选）","options":[{"id":"a","text":"AB＋BC＝AC"},{"id":"b","text":"AC－BC＝AB"},{"id":"c","text":"AC＜AB"},{"id":"d","text":"AB＝BC 一定成立"}],"correctAnswer":["a","b"],"explanation":"B 在 AC 内部，所以整段等于两部分之和，也大于每一部分；没有条件保证两部分等长。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r09","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"challenge","responseType":"single-choice","prompt":"P 是线段 AB 的中点，Q 是 PB 的中点，AB＝28 cm，则 AQ 等于多少？","options":[{"id":"a","text":"7 cm"},{"id":"b","text":"14 cm"},{"id":"c","text":"21 cm"},{"id":"d","text":"28 cm"}],"correctAnswer":"c","explanation":"AP＝PB＝14，PQ＝7，点顺序为 A、P、Q、B，因此 AQ＝AP＋PQ＝21 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-segments-r10","knowledgePointId":"g7u-c4-segments","capabilityTag":"中点关系","difficulty":"challenge","responseType":"single-choice","prompt":"A、B、C 在同一直线上依次排列，AB＝10 cm，BC＝16 cm。M、N 分别为 AB、BC 的中点，MN 等于多少？","options":[{"id":"a","text":"3 cm"},{"id":"b","text":"8 cm"},{"id":"c","text":"13 cm"},{"id":"d","text":"26 cm"}],"correctAnswer":"c","explanation":"M、N 分别位于 B 的两侧，MB＝5，BN＝8，因此 MN＝5＋8＝13 cm。","source":"local-reviewed"}
      ]
    },
    {
      "id": "g7u-c4-angles", "subject": "数学", "grade": 7, "semester": "上册", "textbookVersion": "北师大版", "chapterId": "g7u-chapter-4", "title": "角的比较、运算与平分线", "lessonId": "g7-upper-plane-figures", "learningMode": "explanation",
      "capabilityTags": ["角的认识", "角度运算", "角平分线", "角的和差"],
      "learningGuide": {
        "steps": ["角由两条具有公共端点的射线组成；公共端点是顶点。用三个字母表示角时，顶点字母写在中间。", "角的大小由两边张开的程度决定。锐角小于 90°，直角等于 90°，钝角大于 90°且小于 180°，平角等于 180°。", "角度单位采用六十进制：1°＝60′，1′＝60″。加减时不够减要借 1° 作 60′，小数度要乘 60 转换。", "如果射线 OC 在小于 180°的 ∠AOB 内部，那么 ∠AOB＝∠AOC＋∠COB。角平分线还要求这两个角相等，因此各为原角的一半。"],
        "pitfalls": ["射线画得长或短不改变角的大小；不能根据边的长度来比较角。", "使用角的加减之前，要明确射线位于哪个角内部；角平分线必须从顶点出发并把角等分。"]
      },
      "questions": [
        {"id":"g7u-c4-angles-d01","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的认识","difficulty":"basic","responseType":"single-choice","prompt":"∠ABC 的顶点是哪一点？","options":[{"id":"a","text":"A"},{"id":"b","text":"B"},{"id":"c","text":"C"},{"id":"d","text":"无法确定"}],"correctAnswer":"b","explanation":"用三个字母表示角时，中间的字母表示顶点，所以顶点为 B。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d02","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的认识","difficulty":"basic","responseType":"single-choice","prompt":"一个角的度数为 125°，它属于哪一类角？","options":[{"id":"a","text":"锐角"},{"id":"b","text":"直角"},{"id":"c","text":"钝角"},{"id":"d","text":"平角"}],"correctAnswer":"c","explanation":"125°大于 90°且小于 180°，符合钝角的定义。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d03","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的认识","difficulty":"basic","responseType":"true-false","prompt":"把表示同一个角的两条射线画得更长，这个角就会变大。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"角的大小只与两边张开的程度有关，与射线在纸上画出的长度无关。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d04","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的认识","difficulty":"advanced","responseType":"multi-choice","prompt":"下列哪些角是锐角？（多选）","options":[{"id":"a","text":"35°"},{"id":"b","text":"89°"},{"id":"c","text":"90°"},{"id":"d","text":"120°"}],"correctAnswer":["a","b"],"explanation":"锐角的度数大于 0°且小于 90°，所以 35°和 89°是锐角。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d05","knowledgePointId":"g7u-c4-angles","capabilityTag":"角度运算","difficulty":"advanced","responseType":"single-choice","prompt":"30°40′＋25°35′ 等于多少？","options":[{"id":"a","text":"55°15′"},{"id":"b","text":"55°35′"},{"id":"c","text":"56°15′"},{"id":"d","text":"56°25′"}],"correctAnswer":"c","explanation":"40′＋35′＝75′＝1°15′，所以总和为 30°＋25°＋1°15′＝56°15′。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d06","knowledgePointId":"g7u-c4-angles","capabilityTag":"角平分线","difficulty":"advanced","responseType":"true-false","prompt":"射线 OC 是 ∠AOB 的角平分线，∠AOB＝76°，则 ∠AOC＝38°。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"角平分线将原角分成两个相等的角，所以 ∠AOC＝76°÷2＝38°。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d07","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的和差","difficulty":"advanced","responseType":"single-choice","prompt":"射线 OC 在 ∠AOB 内部，∠AOB＝100°，∠AOC＝35°，则 ∠COB 等于多少？","options":[{"id":"a","text":"35°"},{"id":"b","text":"50°"},{"id":"c","text":"65°"},{"id":"d","text":"135°"}],"correctAnswer":"c","explanation":"OC 在角内部，故 ∠AOB＝∠AOC＋∠COB，得到 ∠COB＝100°－35°＝65°。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d08","knowledgePointId":"g7u-c4-angles","capabilityTag":"角平分线","difficulty":"challenge","responseType":"multi-choice","prompt":"∠AOB＝80°，OC 是它的角平分线。下列哪些结论正确？（多选）","options":[{"id":"a","text":"∠AOC＝40°"},{"id":"b","text":"∠COB＝40°"},{"id":"c","text":"∠AOC＋∠COB＝80°"},{"id":"d","text":"∠AOC＝80°"}],"correctAnswer":["a","b","c"],"explanation":"两个半角都是 80°÷2＝40°，相加等于原来的 80°，半角不等于原角。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d09","knowledgePointId":"g7u-c4-angles","capabilityTag":"角度运算","difficulty":"challenge","responseType":"single-choice","prompt":"70°20′－35°45′ 的规范结果是多少？","options":[{"id":"a","text":"34°35′"},{"id":"b","text":"35°25′"},{"id":"c","text":"35°35′"},{"id":"d","text":"34°25′"}],"correctAnswer":"a","explanation":"借 1°为 60′，70°20′＝69°80′，相减得 34°35′。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-d10","knowledgePointId":"g7u-c4-angles","capabilityTag":"角平分线","difficulty":"challenge","responseType":"single-choice","prompt":"∠AOB＝120°，OC 是 ∠AOB 的角平分线，OD 是 ∠AOC 的角平分线，则 ∠DOB 等于多少？","options":[{"id":"a","text":"30°"},{"id":"b","text":"60°"},{"id":"c","text":"90°"},{"id":"d","text":"120°"}],"correctAnswer":"c","explanation":"∠AOC＝60°，∠AOD＝30°，OD 在 ∠AOB 内部，因此 ∠DOB＝120°－30°＝90°。","source":"local-reviewed"}
      ],
      "retestQuestions": [
        {"id":"g7u-c4-angles-r01","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的认识","difficulty":"basic","responseType":"single-choice","prompt":"以射线 OP、OQ 为两边的角，用三个字母应怎样表示？","options":[{"id":"a","text":"∠OPQ"},{"id":"b","text":"∠PQO"},{"id":"c","text":"∠POQ"},{"id":"d","text":"∠QPO"}],"correctAnswer":"c","explanation":"两条射线的公共端点 O 是角的顶点，必须放在中间，所以是 ∠POQ。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r02","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的认识","difficulty":"basic","responseType":"single-choice","prompt":"平角的度数是多少？","options":[{"id":"a","text":"45°"},{"id":"b","text":"90°"},{"id":"c","text":"180°"},{"id":"d","text":"360°"}],"correctAnswer":"c","explanation":"平角的两边互为反向射线，度数是 180°，不是一周的 360°。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r03","knowledgePointId":"g7u-c4-angles","capabilityTag":"角度运算","difficulty":"basic","responseType":"true-false","prompt":"1.5°等于 1°50′。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"false","explanation":"0.5°＝0.5×60′＝30′，因此 1.5°＝1°30′，不是 1°50′。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r04","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的认识","difficulty":"advanced","responseType":"multi-choice","prompt":"下列哪些角是钝角？（多选）","options":[{"id":"a","text":"91°"},{"id":"b","text":"150°"},{"id":"c","text":"180°"},{"id":"d","text":"60°"}],"correctAnswer":["a","b"],"explanation":"钝角必须大于 90°且小于 180°；91°和 150°符合，180°是平角。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r05","knowledgePointId":"g7u-c4-angles","capabilityTag":"角度运算","difficulty":"advanced","responseType":"single-choice","prompt":"42°50′＋18°25′ 的规范结果是多少？","options":[{"id":"a","text":"60°15′"},{"id":"b","text":"61°15′"},{"id":"c","text":"61°25′"},{"id":"d","text":"60°35′"}],"correctAnswer":"b","explanation":"50′＋25′＝75′＝1°15′，42°＋18°＋1°15′＝61°15′。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r06","knowledgePointId":"g7u-c4-angles","capabilityTag":"角平分线","difficulty":"advanced","responseType":"true-false","prompt":"射线 OR 在 ∠POQ 内部，且 ∠POR＝∠ROQ，因此 OR 是 ∠POQ 的角平分线。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"从顶点出发、位于角内部并将原角分成两个相等的角，满足角平分线定义。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r07","knowledgePointId":"g7u-c4-angles","capabilityTag":"角的和差","difficulty":"advanced","responseType":"single-choice","prompt":"射线 OR 在 ∠POQ 内部，∠POQ＝135°，∠POR＝47°，则 ∠ROQ 等于多少？","options":[{"id":"a","text":"47°"},{"id":"b","text":"88°"},{"id":"c","text":"92°"},{"id":"d","text":"182°"}],"correctAnswer":"b","explanation":"∠ROQ 是总角减去 ∠POR，即 135°－47°＝88°。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r08","knowledgePointId":"g7u-c4-angles","capabilityTag":"角平分线","difficulty":"challenge","responseType":"multi-choice","prompt":"∠POQ＝110°，OR 是它的角平分线。哪些说法正确？（多选）","options":[{"id":"a","text":"∠POR＝55°"},{"id":"b","text":"∠ROQ 是锐角"},{"id":"c","text":"∠POR＝110°"},{"id":"d","text":"∠ROQ＝55°"}],"correctAnswer":["a","b","d"],"explanation":"两个半角均为 110°÷2＝55°，55°小于 90°，因此它们都是锐角。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r09","knowledgePointId":"g7u-c4-angles","capabilityTag":"角度运算","difficulty":"challenge","responseType":"single-choice","prompt":"90°10′－42°35′ 的规范结果是多少？","options":[{"id":"a","text":"47°35′"},{"id":"b","text":"48°25′"},{"id":"c","text":"47°25′"},{"id":"d","text":"48°35′"}],"correctAnswer":"a","explanation":"90°10′＝89°70′，再减 42°35′，得到 47°35′。","source":"local-reviewed"},
        {"id":"g7u-c4-angles-r10","knowledgePointId":"g7u-c4-angles","capabilityTag":"角平分线","difficulty":"challenge","responseType":"single-choice","prompt":"∠POQ＝100°，OR 平分 ∠POQ，OS 平分 ∠ROQ，则 ∠POS 等于多少？","options":[{"id":"a","text":"25°"},{"id":"b","text":"50°"},{"id":"c","text":"75°"},{"id":"d","text":"100°"}],"correctAnswer":"c","explanation":"∠POR＝50°，∠ROS＝25°；OS 位于 ∠ROQ 内部，所以 ∠POS＝50°＋25°＝75°。","source":"local-reviewed"}
      ]
    },
    {
      "id": "g7u-c4-polygons", "subject": "数学", "grade": 7, "semester": "上册", "textbookVersion": "北师大版", "chapterId": "g7u-chapter-4", "title": "多边形与圆的初步认识", "lessonId": "g7-upper-plane-figures", "learningMode": "explanation",
      "capabilityTags": ["多边形认识", "对角线计数", "圆的认识", "扇形关系"],
      "learningGuide": {
        "steps": ["多边形由不在同一直线上的若干线段首尾顺次相接围成，边数和顶点数相等；正多边形还要求各边相等、各内角相等。", "连接多边形两个不相邻顶点的线段叫对角线。从凸 n 边形的一个顶点可画 n－3 条对角线，并分成 n－2 个三角形。", "圆由圆心和半径确定；同一个圆的半径都相等，直径等于半径的 2 倍。不要把连接圆上任意两点的线段都当成直径。", "扇形由两条半径和一条弧围成。同一圆中，扇形面积占圆面积的比例等于圆心角占 360°的比例，例如 90°对应四分之一圆。"],
        "pitfalls": ["数对角线时不能把边算进去，统计全图时同一条对角线不能从两个端点重复计数。", "扇形的圆心角是两条半径在圆心处构成的角，面积占比要除以 360°，不能除以 180°。"]
      },
      "questions": [
        {"id":"g7u-c4-polygons-d01","knowledgePointId":"g7u-c4-polygons","capabilityTag":"多边形认识","difficulty":"basic","responseType":"single-choice","prompt":"一个六边形有多少个顶点？","options":[{"id":"a","text":"4 个"},{"id":"b","text":"5 个"},{"id":"c","text":"6 个"},{"id":"d","text":"8 个"}],"correctAnswer":"c","explanation":"多边形的边数与顶点数相同，所以六边形有六个顶点。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d02","knowledgePointId":"g7u-c4-polygons","capabilityTag":"圆的认识","difficulty":"basic","responseType":"single-choice","prompt":"一个圆的半径是 5 cm，它的直径是多少？","options":[{"id":"a","text":"2.5 cm"},{"id":"b","text":"5 cm"},{"id":"c","text":"10 cm"},{"id":"d","text":"25 cm"}],"correctAnswer":"c","explanation":"同一个圆中，直径等于半径的两倍，所以直径为 2×5＝10 cm。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d03","knowledgePointId":"g7u-c4-polygons","capabilityTag":"对角线计数","difficulty":"basic","responseType":"true-false","prompt":"多边形的对角线，是连接两个不相邻顶点的线段。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"连接相邻顶点得到边，连接不相邻顶点得到对角线，二者要区分。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d04","knowledgePointId":"g7u-c4-polygons","capabilityTag":"多边形认识","difficulty":"advanced","responseType":"multi-choice","prompt":"下列图形中，哪些是正多边形？（多选）","options":[{"id":"a","text":"等边三角形"},{"id":"b","text":"正方形"},{"id":"c","text":"长为 5 cm、宽为 3 cm 的长方形"},{"id":"d","text":"圆"}],"correctAnswer":["a","b"],"explanation":"正多边形要求各边相等、各角相等；等边三角形和正方形满足，非正方形长方形各边不全等，圆不是多边形。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d05","knowledgePointId":"g7u-c4-polygons","capabilityTag":"对角线计数","difficulty":"advanced","responseType":"single-choice","prompt":"从凸五边形的一个顶点出发，可以画多少条对角线？","options":[{"id":"a","text":"1 条"},{"id":"b","text":"2 条"},{"id":"c","text":"3 条"},{"id":"d","text":"5 条"}],"correctAnswer":"b","explanation":"除自身和两个相邻顶点外，还有 5－3＝2 个顶点可连接成对角线。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d06","knowledgePointId":"g7u-c4-polygons","capabilityTag":"圆的认识","difficulty":"advanced","responseType":"true-false","prompt":"同一个圆内，所有半径的长度都相等。","options":[{"id":"true","text":"正确"},{"id":"false","text":"错误"}],"correctAnswer":"true","explanation":"圆上每一个点到圆心的距离都等于半径，所以同一圆的半径全部相等。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d07","knowledgePointId":"g7u-c4-polygons","capabilityTag":"扇形关系","difficulty":"advanced","responseType":"single-choice","prompt":"一个圆被等分为 8 个扇形，每个扇形的圆心角是多少？","options":[{"id":"a","text":"30°"},{"id":"b","text":"40°"},{"id":"c","text":"45°"},{"id":"d","text":"60°"}],"correctAnswer":"c","explanation":"一周是 360°，平均分成 8 份，每份为 360°÷8＝45°。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d08","knowledgePointId":"g7u-c4-polygons","capabilityTag":"圆的认识","difficulty":"challenge","responseType":"multi-choice","prompt":"在同一个圆中，下列哪些说法正确？（多选）","options":[{"id":"a","text":"直径是半径的两倍"},{"id":"b","text":"直径一定经过圆心"},{"id":"c","text":"连接圆上任意两点的线段都是直径"},{"id":"d","text":"每条半径都连接圆心与圆上一点"}],"correctAnswer":["a","b","d"],"explanation":"直径经过圆心且两端在圆上，因此由两条半径组成；任意弦未必经过圆心，不能都称为直径。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d09","knowledgePointId":"g7u-c4-polygons","capabilityTag":"对角线计数","difficulty":"challenge","responseType":"single-choice","prompt":"从凸七边形的一个顶点画出所有对角线，可以把这个七边形分成多少个三角形？","options":[{"id":"a","text":"4 个"},{"id":"b","text":"5 个"},{"id":"c","text":"6 个"},{"id":"d","text":"7 个"}],"correctAnswer":"b","explanation":"凸 n 边形从一个顶点画出所有对角线可分成 n－2 个三角形，这里是 7－2＝5 个。","source":"local-reviewed"},
        {"id":"g7u-c4-polygons-d10","knowledgePointId":"g7u-c4-polygons","capabilityTag":"扇形关系","difficulty":"challenge","responseType":"single-choice","prompt":"在同一个圆中，圆心角为 120°的扇形面积占整个圆面积的几分之几？","options":[{"id":"a","text":"1/2"},{"id":"b","text":"1/3"},{"id":"c","text":"1/4"},{"id":"d","text":"2/3"}],"correctAnswer":"b","explanation":"同圆中面积占比等于圆心角占比，120°÷360°＝1/3。","source":"local-reviewed"}
